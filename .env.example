# Optional: enables hosted speech-to-text with word timestamps.
OPENAI_API_KEY=

# Optional alternative to OpenAI. A command template for a local Whisper/WhisperX
# installation. %INPUT% and %OUTPUT% are replaced with absolute file paths.
# The command must write a JSON file containing segments or words to %OUTPUT%.
WHISPER_COMMAND=

# Required only for server-side MP4 export. Leave blank to use ffmpeg from PATH.
FFMPEG_PATH=
PORT=3000
MAX_UPLOAD_MB=250
